# Frontend Environment Variables
# Copy this file to .env.local for local development

# ─── Demo Mode ────────────────────────────────────────────────────
# Set to "true" to use Dexie.js local DB instead of the real backend
VITE_DEMO_MODE=false

# ─── API ──────────────────────────────────────────────────────────
# Backend API URL (only used when VITE_DEMO_MODE=false)
VITE_API_URL=http://localhost:3001

# ─── App Meta ─────────────────────────────────────────────────────
VITE_APP_NAME=DomusFlow
VITE_APP_VERSION=1.0.0-local

# ─── Base Path (GitHub Pages deployment sets this to /domus-flow/) ─
VITE_BASE_PATH=/
